# Copy to .env to override the defaults in app/config/Settings.py.

QDRANT_URL=http://localhost:6333
ACTIVE_ALIAS=corpus_active
VALIDITY_REGISTRY_PATH=../data/validity_registry.yaml

# Must match the collection; the server refuses to start otherwise.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DIMENSIONS=384

BRANCH_CANDIDATES=20
DEFAULT_RESULT_LIMIT=5
REJECTION_COSINE_THRESHOLD=0.84
